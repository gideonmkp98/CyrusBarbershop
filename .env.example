# Database
DATABASE_URL=mysql://user:password@localhost:3306/cyrus

# Session secret (generate a random string of at least 32 characters)
SESSION_SECRET=your-super-secret-session-key-at-least-32-chars

# Owner admin account
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=YourSecurePassword123!

# Public site URL (for Vercel: https://your-project.vercel.app)
PUBLIC_SITE_URL=http://localhost:5173

# SMTP configuration for transactional email (Mailcow)
SMTP_HOST=mail.yourdomain.nl
SMTP_PORT=587
SMTP_USER=info@cyrusbarbershop.nl
SMTP_PASSWORD=your-mailcow-app-password
MAIL_FROM=info@cyrusbarbershop.nl

# Notification recipients (optional — each falls back to the next, then OWNER_EMAIL)
# Where contact-form submissions are sent.
CONTACT_NOTIFY_EMAIL=info@cyrusbarbershop.nl
# Where new-appointment notifications are sent.
BOOKING_NOTIFY_EMAIL=info@cyrusbarbershop.nl

# Feature toggles
# Set BOOKING_ENABLED=false to disable public bookings while keeping the site online.
BOOKING_ENABLED=true
